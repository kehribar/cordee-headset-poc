; -----------------------------------------------------------------------------
; PIO-based UART TX (8N1)
;
; OUT pin 0 and side-set pin 0 both map to the TX pin.
; Bit period = 8 state machine clock cycles.
; Clock divider = sys_clk_hz / (baud_rate * 8)
; -----------------------------------------------------------------------------
.program uart_tx
.side_set 1 opt

    pull       side 1 [7] ; Pull data word, assert idle/stop bit (high)
    set x, 7   side 0 [7] ; Load bit counter=7, assert start bit (low)
bitloop:
    out pins, 1       [6] ; Output 1 data bit (LSB first)
    jmp x-- bitloop       ; Repeat for all 8 bits (8 cycles per bit)
