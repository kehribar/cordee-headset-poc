.program mic_i2s
.side_set 2
.wrap_target
  set x, 30         side 0b11
ch1_:
  nop           [1] side 0b01
  nop              side 0b11
  jmp x-- ch1_      side 0b11
  nop           [1] side 0b01
  nop              side 0b11
  set x, 30         side 0b11
ch3_:
  nop           [1] side 0b01
  nop              side 0b11
  jmp x-- ch3_      side 0b11
  nop           [1] side 0b00
  nop              side 0b10
  set x, 30         side 0b10
ch2_:
  nop           [1] side 0b00
  nop              side 0b10
  jmp x-- ch2_      side 0b10
  nop           [1] side 0b00
  nop              side 0b10
  set x, 30         side 0b10
ch4_:
  nop           [1] side 0b00
    in  pins, 1    side 0b10
  jmp x-- ch4_      side 0b10
  nop           [1] side 0b01
    in  pins, 1    side 0b11
.wrap
.program mic_mclk
.wrap_target
  set pins, 1
  set pins, 0
.wrap
