; -----------------------------------------------------------------------------
; RX-only I2S (master): generate BCLK + LRCK, sample SDOUT
; -----------------------------------------------------------------------------
.program mic_i2s

  ; ...........................................................................
  ; side #0  ---> LRCK
  ; side #1  ---> BCLK
  ; input #0 ---> SDOUT
  ; ...........................................................................

.side_set 2

.wrap_target

  ; ...
  set x, 30         side 0b11

left_:

  ; ...
  nop           [1] side 0b01
  in  pins, 1       side 0b11
  jmp x-- left_     side 0b11

  ; ...
  nop           [1] side 0b00
  in  pins, 1       side 0b10
  set x, 30         side 0b10

right_:

  ; ...
  nop           [1] side 0b00
  in  pins, 1       side 0b10
  jmp x-- right_    side 0b10

  ; ...
  nop           [1] side 0b01
  in  pins, 1       side 0b11

.wrap

; -----------------------------------------------------------------------------
; Master clock generator: 2 PIO cycles = 1 MCLK period (50% duty)
; -----------------------------------------------------------------------------
.program mic_mclk

.wrap_target

  ; ...........................................................................
  ; set #0 ---> MCLK
  ; ...........................................................................

  ; ...
  set pins, 1
  set pins, 0

.wrap
